{% extends "base.html" %}
{% block title %}Import memories · Second Brain{% endblock %}
{% block content %}
<section class="import-page reveal">
  <header class="page-hero compact-hero">
    <div class="eyebrow"><span>03</span> {{ t("Import desk") }}</div>
    <h1>{{ t("Bring the day") }}<br><em>{{ t("into focus.") }}</em></h1>
    <p class="lede">{{ t("Upload strict JSON produced with the unified Second Brain prompt. The complete file is validated before anything is stored.") }}</p>
  </header>

  <div class="import-layout">
    <form class="upload-panel" method="post" action="/import" enctype="multipart/form-data">
      <input name="csrf_token" type="hidden" value="{{ csrf_token }}">
      <label class="drop-zone" for="files">
        <span class="drop-icon" aria-hidden="true">↥</span>
        <strong>{{ t("Drop JSON files here") }}</strong>
        <span>{{ t("or choose from your device") }}</span>
        <small>{{ t("Up to") }} {{ max_upload_mb }} {{ t("MB per file") }}</small>
      </label>
      <input id="files" name="files" type="file" accept="application/json,.json" multiple required>
      <div id="file-list" class="file-list" aria-live="polite"></div>
      <button class="button button-dark button-wide" type="submit">{{ t("Validate & import") }}</button>
    </form>
    <aside class="import-notes">
      <div class="section-heading"><span>{{ t("Method") }}</span><h2>{{ t("Three steps") }}</h2></div>
      <ol>
        <li><span>01</span><div><strong>{{ t("Copy the prompt") }}</strong><p>{{ t("Open it in ChatGPT, Claude, Copilot, or another capable model.") }}</p></div></li>
        <li><span>02</span><div><strong>{{ t("Add your source") }}</strong><p>{{ t("Paste notes, email, briefings, or transcript text after the divider.") }}</p></div></li>
        <li><span>03</span><div><strong>{{ t("Import the JSON") }}</strong><p>{{ t("Save the model’s JSON response and upload it here.") }}</p></div></li>
      </ol>
      <div class="format-guide" aria-label="{{ t('Accepted JSON formats') }}">
        <p><span>3.0</span><strong>{{ t("Recommended: unified atlas") }}</strong><small>{{ t("Populates memories, topics, tasks, search, and graph together.") }}</small></p>
        <p><span>1.0</span><strong>{{ t("Legacy memories") }}</strong><small>{{ t("Populates memory views and is projected into the graph.") }}</small></p>
        <p><span>2.0</span><strong>{{ t("Legacy graph only") }}</strong><small>{{ t("Populates only the graph; it cannot create grounded memories or tasks.") }}</small></p>
      </div>
      <a class="text-link" href="/prompt">{{ t("Open the AI prompt →") }}</a>
    </aside>
  </div>

  {% if results %}
  <section class="import-results" aria-live="polite">
    <div class="section-heading"><span>{{ t("Result") }}</span><h2>{{ t("Import report") }}</h2></div>
    {% for result in results %}
    <article class="result result-{{ result.status }}"><span aria-hidden="true">{% if result.status == 'success' %}✓{% else %}!{% endif %}</span><div><h3>{{ result.name }}</h3><p>{{ result.message }}</p></div></article>
    {% endfor %}
    {% set destinations = namespace(memories=false, graph=false) %}
    {% for result in results if result.status == 'success' %}
      {% if result.surface == 'atlas' or result.surface == 'memories' %}{% set destinations.memories = true %}{% endif %}
      {% if result.surface == 'atlas' or result.surface == 'graph' %}{% set destinations.graph = true %}{% endif %}
    {% endfor %}
    <div class="result-actions">
      {% if destinations.memories %}<a class="button button-accent" href="/">{{ t("View imported memories") }}</a>{% endif %}
      {% if destinations.graph %}<a class="button button-ghost" href="/graph">{{ t("View graph") }}</a>{% endif %}
    </div>
  </section>
  {% endif %}
</section>
{% endblock %}

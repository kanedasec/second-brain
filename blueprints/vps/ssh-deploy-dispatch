#!/bin/bash
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly original_command="${SSH_ORIGINAL_COMMAND:-}"

# Add every allowed command name to the regular expression and case statement.
if [[ "$original_command" =~ ^(deploy-sgp-manager|__DEPLOY_COMMAND__)[[:space:]](sha-[0-9a-f]{40})$ ]]; then
    readonly command_name="${BASH_REMATCH[1]}"
    readonly requested_tag="${BASH_REMATCH[2]}"
else
    echo "SSH command denied" >&2
    exit 126
fi

case "$command_name" in
    deploy-sgp-manager)
        script=/usr/local/sbin/deploy-sgp-manager
        ;;
    __DEPLOY_COMMAND__)
        script=/usr/local/sbin/__DEPLOY_COMMAND__
        ;;
    *)
        echo "SSH command denied" >&2
        exit 126
        ;;
esac

exec /usr/bin/sudo -n "$script" "$requested_tag"
